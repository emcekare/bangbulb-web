# BangBulb Web — ortam değişkenleri
#
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env*` gitignore'da; gerçek anahtarlar repoya girmez.
# Production değerleri GitHub → Settings → Secrets and variables → Actions
# altına eklenir ve workflow tarafından build sırasında enjekte edilir.

# --- İletişim formu (Web3Forms) -------------------------------------------
# https://web3forms.com adresine e-posta adresinizi girin, anahtar mail olarak
# gelir. Ücretsiz, sınırsız gönderim. Tanımlı değilse form mailto'ya düşer.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Analytics (Umami) ----------------------------------------------------
# Umami script URL'i ve website ID'si. Boş bırakılırsa analytics yüklenmez.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Site ------------------------------------------------------------------
# Canonical URL, OG etiketleri ve sitemap için kullanılır.
NEXT_PUBLIC_SITE_URL=https://bangbulb.com
